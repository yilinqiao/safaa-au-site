---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { activityBoard, copy, featuredEvents, linkedinPage, xiaohongshuPage } from '../../data/site';
const t = copy.zh;
---
<BaseLayout locale="zh" title="SAFAA — 澳洲亚裔女性社群">
  <section class="hero"><div class="hero-inner wrap"><span class="eyebrow">{t.eyebrow}</span><h1>{t.heroTitle}</h1><p>{t.heroBody}</p><div class="actions"><a class="button button-primary" href="/zh/events/">{t.explore}</a><a class="button button-secondary" href="/zh/about/">{t.vision}</a></div></div></section>
  <section class="stats wrap" aria-label="SAFAA 社群概览"><div class="stat"><strong>2,300+</strong><span>{t.members}</span></div><div class="stat"><strong>100+</strong><span>{t.volunteers}</span></div><div class="stat"><strong>5</strong><span>{t.cities}</span></div><div class="stat"><strong>AU</strong><span>{t.network}</span></div></section>
  <section class="section"><div class="wrap"><div class="section-head"><div><h2>{t.featured}</h2><div class="accent"></div></div><a class="event-link section-link" href="/zh/events/">{t.seeAll} <span aria-hidden="true">→</span></a></div><div class="event-grid">{featuredEvents.map((event) => <EventCard event={event} locale="zh" />)}</div></div></section>
  <section class="section dark-section"><div class="wrap split"><div><h2>{t.missionTitle}</h2><p>{t.missionBody}</p><a class="button button-warm" href="/zh/about/">{t.learn}</a></div><img class="round-image" src="/images/sydney-girls-ai-2025.webp" alt="SAFAA Girls x AI 活动参与者合照" loading="lazy" /></div></section>
  <section class="closing-links"><div class="wrap"><a href="/zh/events/">{t.seeAll}</a><a href={activityBoard} rel="noreferrer">公开活动看板</a><a href={linkedinPage} rel="noreferrer">SAFAA LinkedIn</a><a href={xiaohongshuPage} rel="noreferrer">SAFAA 小红书</a></div></section>
</BaseLayout>
