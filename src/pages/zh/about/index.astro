---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { copy } from '../../../data/site';
const t = copy.zh;
---
<BaseLayout locale="zh" title="关于 SAFAA — 使命、愿景与社群" description={t.aboutBody}>
  <section class="page-hero"><div class="wrap"><h1>{t.aboutTitle}</h1><p>{t.aboutBody}</p></div></section>
  <section class="section"><div class="wrap split"><img class="about-image" src="/images/community-hero-clean.webp" alt="参与 SAFAA 社群工作坊的女性" /><div class="prose"><h2>{t.mission}</h2><p>{t.missionText}</p><h2>我们的愿景</h2><p>{t.visionText}</p><p>超过 100 位志愿者在悉尼、墨尔本、阿德莱德、珀斯和布里斯班组织活动，涵盖职场与科技学习、运动、读书和真诚对话。</p></div></div></section>
  <section class="section dark-section"><div class="wrap split"><div><h2>我们欢迎谁</h2><p>社群连接处于不同职场和人生阶段的亚裔女性。职场人士、创业者、学生，以及正在探索新方向的女性，都可以在这里互相学习。</p><p>SAFAA 由志愿者共同建设，保持开放，也重视实实在在的支持。</p><a class="button button-warm" href="mailto:info@safaa-nonprofit.org">联系我们</a></div><div class="about-mark" aria-hidden="true"><span>2,300+</span><small>社群成员</small></div></div></section>
</BaseLayout>
