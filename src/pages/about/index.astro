---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { copy } from '../../data/site';
const t = copy.en;
---
<BaseLayout locale="en" title="About SAFAA — Mission, vision and community" description={t.aboutBody}>
  <section class="page-hero"><div class="wrap"><h1>{t.aboutTitle}</h1><p>{t.aboutBody}</p></div></section>
  <section class="section"><div class="wrap split"><img class="about-image" src="/images/community-hero-clean.webp" alt="Women attending a SAFAA community workshop" /><div class="prose"><h2>{t.mission}</h2><p>{t.missionText}</p><h2>Our vision</h2><p>{t.visionText}</p><p>More than 100 volunteers help create activities across Sydney, Melbourne, Adelaide, Perth and Brisbane — from career and technology learning to movement, books and honest conversation.</p></div></div></section>
  <section class="section dark-section"><div class="wrap split"><div><h2>Who we welcome</h2><p>Our community connects Asian women at different career and life stages. Professionals, founders, students and women exploring a new direction can learn from one another here.</p><p>SAFAA is volunteer-led, open-minded and grounded in practical support.</p><a class="button button-warm" href="mailto:info@safaa-nonprofit.org">Get in touch</a></div><div class="about-mark" aria-hidden="true"><span>2,300+</span><small>community members</small></div></div></section>
</BaseLayout>
