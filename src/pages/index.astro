---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import { activityBoard, copy, featuredEvents } from '../data/site';
const t = copy.en;
---
<BaseLayout locale="en" title="SAFAA — A connected community for Asian women in Australia">
  <section class="hero"><div class="hero-inner wrap"><span class="eyebrow">{t.eyebrow}</span><h1>{t.heroTitle}</h1><p>{t.heroBody}</p><div class="actions"><a class="button button-primary" href="/events/">{t.explore}</a><a class="button button-secondary" href="/about/">{t.vision}</a></div></div></section>
  <section class="stats wrap" aria-label="SAFAA at a glance"><div class="stat"><strong>2,300+</strong><span>{t.members}</span></div><div class="stat"><strong>100+</strong><span>{t.volunteers}</span></div><div class="stat"><strong>5</strong><span>{t.cities}</span></div><div class="stat"><strong>AU</strong><span>{t.network}</span></div></section>
  <section class="section"><div class="wrap"><div class="section-head"><div><h2>{t.featured}</h2><div class="accent"></div></div><a class="event-link section-link" href="/events/">{t.seeAll} <span aria-hidden="true">→</span></a></div><div class="event-grid">{featuredEvents.map((event) => <EventCard event={event} locale="en" />)}</div></div></section>
  <section class="section dark-section"><div class="wrap split"><div><h2>{t.missionTitle}</h2><p>{t.missionBody}</p><a class="button button-warm" href="/about/">{t.learn}</a></div><img class="round-image" src="/images/sydney-girls-ai-2025.webp" alt="SAFAA Girls x AI participants together after the workshop" loading="lazy" /></div></section>
  <section class="closing-links"><div class="wrap"><a href="/events/">{t.seeAll}</a><a href={activityBoard} rel="noreferrer">Public activity archive</a><a href="https://xhslink.cn/m/AMpKhDSChIj" rel="noreferrer">SAFAA on Xiaohongshu</a></div></section>
</BaseLayout>
