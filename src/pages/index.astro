---
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy, events } from '../data/site';
const t = copy.en;
const featured = events.slice(0, 3);
---
<BaseLayout locale="en" title="SAFAA — A connected community for Asian women in Australia">
  <section class="hero" style={`--hero-image:url(${featured[1].image})`}><div class="hero-inner wrap"><span class="eyebrow">{t.eyebrow}</span><h1>{t.heroTitle}</h1><p>{t.heroBody}</p><div class="actions"><a class="button button-primary" href="/about/">{t.explore}</a><a class="button button-secondary" href="/about/">{t.vision}</a></div></div></section>
  <section class="stats wrap"><div class="stat"><strong>2,300+</strong><span>{t.members}</span></div><div class="stat"><strong>5</strong><span>{t.cities}</span></div><div class="stat"><strong>100+</strong><span>{t.volunteers}</span></div><div class="stat"><strong>6</strong><span>{t.years}</span></div></section>
  <section class="section"><div class="wrap"><div class="section-head"><div><h2>{t.featured}</h2><div class="accent"></div></div><a class="event-link" href="/events/">{t.seeAll}</a></div><div class="event-grid">{featured.map((event) => <a class="event-card" href={`/events/${event.slug}/`}><div class="event-image"><img src={event.image} alt={event.title} loading="lazy" /><span class="pill">{event.city}</span></div><div class="event-content"><div class="event-meta">{event.date} · {event.type}</div><h3>{event.title}</h3><p>{event.summary}</p><span class="event-link">Read story →</span></div></a>)}</div></div></section>
  <section class="section dark-section"><div class="wrap split"><div><h2>{t.missionTitle}</h2><p>{t.missionBody}</p><a class="button button-primary" href="/about/">{t.learn}</a></div><img class="round-image" src="/images/vision-mission.png" alt="SAFAA community mission" loading="lazy" /></div></section>
</BaseLayout>
