---
import '@fontsource-variable/inter';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/800.css';
import { copy, type Locale } from '../data/site';

const { locale = 'en', title = 'SAFAA — Starleap Asian Female Association Of Australia Inc', description } = Astro.props;
const t = copy[locale as Locale];
const pageDescription = description ?? t.heroBody;
const zhHref = Astro.url.pathname.startsWith('/zh') ? Astro.url.pathname : `/zh${Astro.url.pathname === '/' ? '' : Astro.url.pathname}`;
const enHref = Astro.url.pathname.startsWith('/zh') ? Astro.url.pathname.replace(/^\/zh/, '') || '/' : Astro.url.pathname;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" href="/images/safaa-logo.png" />
    <title>{title}</title>
  </head>
  <body>
    <div class="topbar"><div class="wrap topbar-inner"><span>Australia-wide community · 2,300+ members</span><a href={locale === 'en' ? zhHref : enHref}>{t.language}</a></div></div>
    <header class="site-header"><div class="wrap nav-row">
      <a href={locale === 'en' ? '/' : '/zh/'} class="brand" aria-label="SAFAA home"><img src="/images/safaa-logo.png" alt="SAFAA" /><span>Starleap Asian Female Association<br />Of Australia Inc</span></a>
      <nav aria-label="Primary navigation"><a href={locale === 'en' ? '/' : '/zh/'}>{t.home}</a><a href={locale === 'en' ? '/events/' : '/zh/events/'}>{t.events}</a><a href={locale === 'en' ? '/about/' : '/zh/about/'}>{t.about}</a><a class="nav-cta" href={`mailto:${t.email}`}>{t.contact}</a></nav>
      <button class="menu-button" aria-label="Open menu" aria-expanded="false" data-menu-button>☰</button>
    </div><div class="mobile-menu" data-mobile-menu><a href={locale === 'en' ? '/' : '/zh/'}>{t.home}</a><a href={locale === 'en' ? '/events/' : '/zh/events/'}>{t.events}</a><a href={locale === 'en' ? '/about/' : '/zh/about/'}>{t.about}</a><a href={`mailto:${t.email}`}>{t.contact}</a></div></header>
    <main><slot /></main>
    <footer class="footer"><div class="wrap footer-grid"><div><div class="footer-brand">SAFAA</div><p>{t.eyebrow}</p></div><div><p class="footer-label">Connect</p><a href="https://xhslink.cn/m/AMpKhDSChIj" rel="noreferrer">小红书 / RED</a><a href="https://iced-beryl-997.notion.site/SAFAA-54391bb39be34aa88dcefa446a4fe2f4" rel="noreferrer">Community activities</a><a href={`mailto:${t.email}`}>{t.email}</a></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} SAFAA</span><span>Made for community.</span></div></footer>
  </body>
</html>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Poppins:wght@700;800&display=swap');
:root{--navy:#062f45;--teal:#13a6ba;--orange:#ffb735;--cream:#f8f7f2;--ink:#122b3a;--muted:#687781;--line:#dde5e8}*{box-sizing:border-box}body{margin:0;color:var(--ink);background:var(--cream);font-family:Inter,'DM Sans',sans-serif}a{color:inherit;text-decoration:none}.wrap{width:min(1160px,calc(100% - 48px));margin:auto}.topbar{background:var(--navy);color:#fff;font-size:11px;letter-spacing:.08em;text-transform:uppercase}.topbar-inner{height:32px;display:flex;align-items:center;justify-content:space-between}.topbar a{text-decoration:underline;text-underline-offset:3px}.site-header{position:sticky;top:0;z-index:10;background:rgba(248,247,242,.96);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}.nav-row{height:82px;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:12px;font-size:9px;line-height:1.2;letter-spacing:.04em;text-transform:uppercase;color:var(--navy);font-weight:700}.brand img{width:48px;height:48px;object-fit:contain}.brand span{display:block}.site-header nav{display:flex;align-items:center;gap:30px;font-size:14px;font-weight:700}.site-header nav a{padding:10px 0}.site-header nav a:hover{color:var(--teal)}.nav-cta{background:var(--teal);color:white!important;padding:11px 20px!important;border-radius:2px}.menu-button{display:none;border:0;background:none;font-size:24px;color:var(--navy)}.mobile-menu{display:none}.footer{background:var(--navy);color:#fff;padding:62px 0 20px}.footer-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:60px}.footer-brand{font:800 48px Poppins;color:var(--orange);letter-spacing:-.05em}.footer p{max-width:360px;color:#b6c7cf;line-height:1.6;font-size:13px}.footer-grid>div:last-child{display:flex;flex-direction:column;gap:14px;align-items:flex-start}.footer-label{color:var(--orange)!important;text-transform:uppercase;letter-spacing:.15em;font-weight:700;font-size:11px!important;margin:0}.footer-grid a{font-size:13px;color:#fff}.footer-bottom{border-top:1px solid rgba(255,255,255,.2);margin-top:55px;padding-top:17px;display:flex;justify-content:space-between;color:#9eb4bd;font-size:11px}
.hero{min-height:610px;display:grid;place-items:center;text-align:center;color:#fff;position:relative;overflow:hidden;background:var(--navy)}.hero::before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(6,47,69,.45),rgba(6,47,69,.88)),var(--hero-image) center/cover}.hero-inner{position:relative;z-index:1;max-width:820px;padding:90px 0}.eyebrow{display:inline-block;border:1px solid rgba(255,255,255,.5);padding:8px 14px;border-radius:99px;font-size:11px;letter-spacing:.1em;text-transform:uppercase;margin-bottom:24px}.hero h1{font:800 clamp(42px,7vw,82px)/1.03 Poppins;margin:0 0 22px;letter-spacing:-.055em}.hero p{font-size:clamp(16px,2vw,21px);line-height:1.6;color:#e6f0f2;max-width:630px;margin:0 auto 34px}.actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}.button{display:inline-flex;align-items:center;justify-content:center;padding:14px 22px;font-weight:700;font-size:13px;border-radius:2px}.button-primary{background:var(--teal);color:#fff}.button-secondary{border:1px solid rgba(255,255,255,.6);color:#fff}.button-dark{background:var(--navy);color:#fff}.stats{position:relative;margin:-38px auto 0;background:#fff;box-shadow:0 15px 34px rgba(6,47,69,.12);border-bottom:4px solid var(--orange);display:grid;grid-template-columns:repeat(4,1fr);padding:28px 20px;z-index:2}.stat{text-align:center;border-right:1px solid var(--line)}.stat:last-child{border:0}.stat strong{display:block;color:var(--navy);font:800 36px Poppins;letter-spacing:-.05em}.stat span{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}.section{padding:92px 0}.section-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:38px}.section h2{font:800 clamp(30px,4vw,50px)/1.1 Poppins;letter-spacing:-.045em;color:var(--navy);margin:0}.section-head p{max-width:370px;color:var(--muted);line-height:1.6;margin:0}.accent{width:75px;height:7px;background:var(--orange);margin-top:15px}.event-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.event-card{background:#fff;box-shadow:0 6px 20px rgba(6,47,69,.07);transition:transform .2s,box-shadow .2s}.event-card:hover{transform:translateY(-5px);box-shadow:0 14px 30px rgba(6,47,69,.14)}.event-image{height:195px;overflow:hidden;position:relative}.event-image img{width:100%;height:100%;object-fit:cover}.event-image .pill{position:absolute;top:13px;right:13px;background:#fff;color:var(--navy);padding:6px 9px;font-size:10px;font-weight:700;text-transform:uppercase}.event-content{padding:22px}.event-meta{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--teal);font-weight:700}.event-content h3{font:700 21px/1.2 Poppins;color:var(--navy);margin:10px 0}.event-content p{color:var(--muted);font-size:13px;line-height:1.6;margin:0 0 18px}.event-link{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;border-bottom:2px solid var(--orange);padding-bottom:4px}.dark-section{background:var(--navy);color:#fff}.dark-section h2{color:#fff}.dark-section p{color:#bfd0d6;line-height:1.75}.split{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}.round-image{width:min(410px,100%);aspect-ratio:1;border-radius:50%;object-fit:cover;border:12px solid rgba(255,183,53,.16);outline:1px solid var(--orange);outline-offset:-26px}.page-hero{background:var(--navy);color:#fff;padding:88px 0}.page-hero h1{font:800 clamp(38px,6vw,72px)/1.05 Poppins;letter-spacing:-.05em;margin:0 0 18px;max-width:750px}.page-hero p{color:#bfd0d6;max-width:620px;font-size:17px;line-height:1.6}.filters{display:flex;gap:9px;flex-wrap:wrap;margin:0 0 35px}.filter{border:1px solid var(--line);background:#fff;padding:10px 14px;font-size:12px;font-weight:700;cursor:pointer}.filter.active{background:var(--teal);border-color:var(--teal);color:#fff}.about-image{width:100%;max-height:480px;object-fit:cover}.prose{color:var(--muted);line-height:1.8}.prose strong{color:var(--navy)}
@media(max-width:760px){.wrap{width:min(100% - 32px,1160px)}.topbar-inner{height:30px}.topbar-inner span{font-size:9px}.site-header nav{display:none}.menu-button{display:block}.mobile-menu{display:none;background:var(--cream);padding:12px 16px 18px;border-top:1px solid var(--line)}.mobile-menu.open{display:flex;flex-direction:column;gap:3px}.mobile-menu a{padding:12px;font-size:15px;font-weight:700}.hero{min-height:590px}.hero-inner{padding:70px 0}.hero h1{font-size:48px}.stats{margin:-22px 16px 0;grid-template-columns:repeat(2,1fr);padding:20px 8px;gap:20px}.stat{border-right:0}.stat strong{font-size:29px}.stat span{font-size:9px}.section{padding:66px 0}.section-head{display:block}.section-head p{margin-top:16px}.event-grid{grid-template-columns:1fr}.event-image{height:220px}.split{grid-template-columns:1fr;gap:35px}.split .round-image{order:-1;max-width:330px;margin:auto}.footer-grid{grid-template-columns:1fr;gap:35px}.footer-bottom{margin-top:35px}.page-hero{padding:62px 0}.page-hero h1{font-size:45px}.brand{font-size:8px}.brand img{width:42px;height:42px}}
</style>
<script>
  const button = document.querySelector('[data-menu-button]');
  const menu = document.querySelector('[data-mobile-menu]');
  button?.addEventListener('click', () => { const open = menu?.classList.toggle('open') ?? false; button.setAttribute('aria-expanded', String(open)); });
</script>
