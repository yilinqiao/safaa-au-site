---
import '@fontsource-variable/inter';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/800.css';
import '../styles/global.css';
import { activityBoard, copy, type Locale } from '../data/site';

const { locale = 'en', title = 'SAFAA — Starleap Asian Female Association Of Australia Inc', description } = Astro.props as { locale?: Locale; title?: string; description?: string };
const t = copy[locale];
const pageDescription = description ?? t.heroBody;
const currentPath = Astro.url.pathname;
const zhPath = currentPath.startsWith('/zh') ? currentPath : `/zh${currentPath === '/' ? '/' : currentPath}`;
const enPath = currentPath.startsWith('/zh') ? currentPath.replace(/^\/zh/, '') || '/' : currentPath;
const canonical = new URL(currentPath, 'https://safaa-au.site').toString();
const enUrl = new URL(enPath, 'https://safaa-au.site').toString();
const zhUrl = new URL(zhPath, 'https://safaa-au.site').toString();
const homePath = locale === 'en' ? '/' : '/zh/';
const eventsPath = locale === 'en' ? '/events/' : '/zh/events/';
const aboutPath = locale === 'en' ? '/about/' : '/zh/about/';
const switchPath = locale === 'en' ? zhPath : enPath;
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en-AU'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SAFAA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content="https://safaa-au.site/images/community-hero.webp" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-AU" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" href="/images/safaa-logo.png" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{locale === 'zh' ? '跳到主要内容' : 'Skip to content'}</a>
    <div class="topbar"><div class="wrap topbar-inner"><span>{locale === 'zh' ? '在澳洲注册的非营利组织 · 遍布五座城市' : 'Registered Australian not-for-profit · Across five cities'}</span><a href={switchPath} lang={locale === 'en' ? 'zh-CN' : 'en-AU'} aria-label={locale === 'en' ? 'Switch to Chinese' : 'Switch to English'}>{t.language}</a></div></div>
    <header class="site-header"><div class="wrap nav-row">
      <a href={homePath} class="brand" aria-label={locale === 'zh' ? 'SAFAA 首页' : 'SAFAA home'}><img src="/images/safaa-logo.png" alt="" width="205" height="63" /><span>Starleap Asian Female Association Of Australia Inc</span></a>
      <nav aria-label={locale === 'zh' ? '主要导航' : 'Primary navigation'}><a href={homePath}>{t.home}</a><a href={eventsPath}>{t.events}</a><a href={aboutPath}>{t.about}</a><a class="nav-cta" href={activityBoard} rel="noreferrer">{locale === 'zh' ? '活动看板' : 'Activity archive'}</a></nav>
      <button class="menu-button" type="button" aria-label={locale === 'zh' ? '打开菜单' : 'Open menu'} aria-controls="mobile-menu" aria-expanded="false" data-menu-button><span aria-hidden="true">☰</span></button>
    </div><nav id="mobile-menu" class="mobile-menu" aria-label={locale === 'zh' ? '手机导航' : 'Mobile navigation'} hidden><a href={homePath}>{t.home}</a><a href={eventsPath}>{t.events}</a><a href={aboutPath}>{t.about}</a><a href={activityBoard} rel="noreferrer">{locale === 'zh' ? '活动看板' : 'Activity archive'}</a></nav></header>
    <main id="main"><slot /></main>
    <footer class="footer"><div class="wrap footer-grid"><div><div class="footer-brand">SAFAA</div><p>{t.eyebrow}</p><p>{locale === 'zh' ? '在澳洲注册的非营利组织' : 'Registered not-for-profit organisation in Australia'}</p></div><div><p class="footer-label">{locale === 'zh' ? '浏览' : 'Explore'}</p><a href={homePath}>{t.home}</a><a href={eventsPath}>{t.events}</a><a href={aboutPath}>{t.about}</a></div><div><p class="footer-label">{locale === 'zh' ? '联系与关注' : 'Connect'}</p><a href={activityBoard} rel="noreferrer">{locale === 'zh' ? '公开活动看板' : 'Public activity board'}</a><a href="https://xhslink.cn/m/AMpKhDSChIj" rel="noreferrer">小红书 / RED</a><a href={`mailto:${t.email}`}>{t.email}</a></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} SAFAA</span><span>{locale === 'zh' ? '一起成长，彼此支持。' : 'Made for community.'}</span></div></footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
      const menu = document.querySelector<HTMLElement>('#mobile-menu');
      button?.addEventListener('click', () => { if (!menu) return; const open = menu.hidden; menu.hidden = !open; button.setAttribute('aria-expanded', String(open)); button.setAttribute('aria-label', open ? (document.documentElement.lang === 'zh-CN' ? '关闭菜单' : 'Close menu') : (document.documentElement.lang === 'zh-CN' ? '打开菜单' : 'Open menu')); });
    </script>
  </body>
</html>
